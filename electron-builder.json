{
  "appId": "com.arcleague.game",
  "productName": "ARC LEAGUE",
  "directories": {
    "output": "dist"
  },
  "files": [
    "index.html",
    "desktop/**/*",
    "src/**/*",
    "assets/**/*",
    "vendor/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "portable",
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
